# HatCatDev API endpoint. Defaults to localhost:8000 if unset.
NEXT_PUBLIC_HATCATDEV_URL=http://localhost:8000

# Admin-tier auth token. HatStand sends this as Authorization: Bearer ...
# in every /v1/admin/* request. Required when HatCatDev is configured to
# enforce admin auth (default in production, optional in single-operator dev).
HATSTAND_ADMIN_TOKEN=
